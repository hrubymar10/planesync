{
  // Jira is the destination tracker.
  "jira": {
    "base_url": "https://jira.example.com",
    "cloud_id": "example-cloud",
    "email": "you@example.com",
    "auth_type": "basic",
    "token": "${JIRA_TOKEN}",
  },

  // Plane is the source tracker.
  "plane": {
    "base_url": "https://api.plane.so",
    "app_base_url": "https://app.plane.so",
    "workspace": "example-workspace",
    "token": "${PLANE_TOKEN}",
  },

  "defaults": {
    "since": "7d",
    "body_format": "rich",
    "deleted_status": "Done",
    "deleted_resolution": "Declined",
    "assign_all_to_me": true,
  },

  "projects": [
    {
      "plane_project": "SRC",
      "jira_project": "DST",
      "jira_issue_type": "Task",
	  "epic_key": "DST-100",
      "title_prefix": "[team]",
      "status_map": {
        "Backlog": "To Do",
        "Started": "In Progress",
        "Completed": "Done",
      },
      "status_group_map": {
        "backlog": "To Do",
        "started": "In Progress",
        "completed": "Done",
      },
      "resolution_map": {
        "Completed": "Done",
        "Cancelled": "Declined",
      },
    },
  ],
}
