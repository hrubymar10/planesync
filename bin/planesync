#!/usr/bin/env bash
# planesync development wrapper: build once for this platform, then reuse it.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
BINARY="$REPO_DIR/planesync-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"

if [ ! -f "$BINARY" ] || [ "${PLANESYNC_FORCE_BUILD:-}" = "1" ]; then
    echo "Building planesync..." >&2
    if ! (cd "$REPO_DIR" && go build -o "$BINARY" ./cmd/planesync); then
        echo "planesync build failed" >&2
        exit 1
    fi
fi

exec "$BINARY" "$@"
